{
  "name": "@devbie/newbie-cli",
  "version": "1.13.0",
  "description": "newbie backend framework CLI",
  "license": "MIT",
  "author": "worldzhy",
  "bin": {
    "newbie": "dist/index.js"
  },
  "exports": {
    "./lib": "./dist/public.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "node --import tsx --test test/*.test.ts",
    "check:template-deps": "node --import tsx scripts/check-template-deps.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@devbie/cli-kit": "^1.0.0",
    "@devbie/modules-state": "^1.0.0",
    "@inquirer/prompts": "^7.0.0",
    "colorette": "^2.0.20",
    "commander": "^12.1.0",
    "figlet": "^1.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/node": "^22.20.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
