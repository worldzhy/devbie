{
  "name": "@devbie/apits",
  "version": "1.0.6",
  "author": "worldzhy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldzhy/devbie.git",
    "directory": "packages/apits"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "bin": {
    "apits": "bin/apits"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "father build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "rm -rf ./api & tsx test/gen.ts --type-check false gen",
    "gen:api-1": "tsx test/gen.ts --type-check false gen -n api-1",
    "init": "tsx test/gen.ts --type-check false init",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "publishOnly": "npm run build",
    "requestTest": "tsx watch test/requestTest.ts --type-check false",
    "test": "tsx test/index.ts",
    "test2": "tsx watch test/json-schema-to-typescript.ts --type-check false"
  },
  "dependencies": {
    "chalk": "^4.1.1",
    "change-case": "^3.1.0",
    "form-data": "^3.0.0",
    "fs-extra": "^7.0.1",
    "got": "^11.5.1",
    "js-yaml": "^5.5.0",
    "json-schema": "^0.4.0",
    "json-schema-to-typescript": "15.0.4",
    "json5": "^2.1.0",
    "openapi-types": "^7.0.1",
    "ora": "5.4.1",
    "prettier": "^3.9.9",
    "prompts": "^2.0.4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "yargs": "^16.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^5.0.4",
    "@types/json-schema": "^7.0.15",
    "@types/json5": "^0.0.30",
    "@types/node": "^18.7.14",
    "@types/prompts": "^1.0.4",
    "@types/yargs": "^16.0.1",
    "father": "^4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
