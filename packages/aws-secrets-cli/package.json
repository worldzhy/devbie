{
  "name": "@devbie/aws-secrets-cli",
  "version": "1.1.3",
  "description": "CLI plugin of the aws-secrets-manager newbie module: pull/push env secrets against AWS Secrets Manager and deploy the rotation Lambda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldzhy/devbie.git",
    "directory": "packages/aws-secrets-cli"
  },
  "author": "worldzhy",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sst"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.929.0",
    "@aws-sdk/client-sts": "^3.969.0",
    "@inquirer/prompts": "^7.0.0",
    "colorette": "^2.0.20"
  },
  "peerDependencies": {
    "@devbie/newbie-cli": "^1.3.0"
  },
  "devDependencies": {
    "@devbie/newbie-cli": "^1.3.0",
    "@types/node": "^22.20.5",
    "commander": "^12.1.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
