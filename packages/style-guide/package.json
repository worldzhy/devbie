{
  "name": "@devbie/style-guide",
  "version": "1.4.1",
  "description": "Single source of truth for devbie ecosystem code style: shared prettier config and composable eslint flat layers (base, nest, next)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldzhy/devbie.git",
    "directory": "packages/style-guide"
  },
  "author": "worldzhy",
  "type": "module",
  "exports": {
    "./prettier": "./prettier.js",
    "./eslint/base": {
      "types": "./eslint/base.d.ts",
      "default": "./eslint/base.js"
    },
    "./eslint/nest": {
      "types": "./eslint/nest.d.ts",
      "default": "./eslint/nest.js"
    },
    "./eslint/next": {
      "types": "./eslint/next.d.ts",
      "default": "./eslint/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "prettier.js",
    "eslint"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.5.8",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.71.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "next": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "next": "^16.4.2"
  }
}
