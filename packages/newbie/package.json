    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "crypto-random-string": "^3.3.1",
    "dayjs": "^1.11.23",
    "dot-object": "^2.1.5",
    "helmet": "^7.1.0",
    "lodash": "^4.17.21",
    "uuid": "^14.0.3"
  },
  "peerDependencies": {
    "@nestjs/axios": "^4.0.0 || ^12.0.0",
