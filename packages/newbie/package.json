  "description": "newbie backend framework runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldzhy/devbie.git",
    "directory": "packages/newbie"
  },
  "author": "worldzhy",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
