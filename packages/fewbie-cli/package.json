{
  "name": "@devbie/fewbie-cli",
  "version": "1.4.0",
  "description": "fewbie frontend framework CLI",
  "license": "MIT",
  "author": "worldzhy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldzhy/devbie.git",
    "directory": "packages/fewbie-cli"
  },
  "bin": {
    "fewbie": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && node --import tsx scripts/build-registry.ts && chmod +x dist/index.js",
    "clean": "rimraf dist",
    "test": "node --import tsx --test test/*.test.ts",
    "check:template-drift": "node --import tsx scripts/check-template-drift.ts",
    "check:template-deps": "node --import tsx scripts/check-template-deps.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@devbie/cli-kit": "^1.0.0",
    "@inquirer/prompts": "^7.5.0",
    "colorette": "^2.0.20",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
